# 이 파일을 EXE와 같은 폴더의 .env로 복사하고 실제 DBeaver 접속정보를 입력합니다.
# jdbc:oracle:thin:@host:1521/ORCL -> host/database/port로 분리합니다.
UMAP_DB_HOST=127.0.0.1
UMAP_DB_DATABASE=ORCL
UMAP_DB_PORT=1521
UMAP_DB_USERNAME=test_user
UMAP_DB_PASSWORD=test_password

# 시작할 데이터 타입: RESPONSE, DEFECT, EPM
UMAP_DATA_TYPE=RESPONSE
UMAP_TARGET_DRAFT_NO=
# 디버깅 시 프로젝트의 queries/umap.sql을 사용합니다.
UMAP_SQL_FILE=queries/umap.sql
# EXE에서 쿼리를 바꾸려면 위 값을 주석 처리하고 별도 SQL 파일의 절대 경로를 입력합니다.
# UMAP_SQL_FILE=C:\\path\\custom_query.sql
