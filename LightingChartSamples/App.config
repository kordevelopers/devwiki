<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!--
          Oracle Exadata 직접 접속 예제입니다.
          다음 값을 실제 환경에 맞게 변경합니다.
          YOUR_EXADATA_HOST : Exadata SCAN/VIP 호스트명 또는 IP
          1521               : Listener 포트
          YOUR_SERVICE_NAME : Oracle SERVICE_NAME
          YOUR_USER_ID      : DB 사용자 ID
          YOUR_PASSWORD     : DB 비밀번호

          tnsnames.ora에 별칭이 이미 설정된 경우에는 connectionString을 다음처럼 단순화할 수 있습니다.
          User Id=YOUR_USER_ID;Password=YOUR_PASSWORD;Data Source=YOUR_TNS_ALIAS;
        -->
        <add name="PcaExadataDatabase"
              connectionString="User Id=YOUR_USER_ID;Password=YOUR_PASSWORD;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=YOUR_EXADATA_HOST)(PORT=1521))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=YOUR_SERVICE_NAME)));Pooling=true;Min Pool Size=0;Max Pool Size=20;Connection Timeout=30;"
              providerName="Oracle.ManagedDataAccess.Client" />
        <!-- 기존 ACT_DATA 공통 API 호환용 설정입니다. ScatterMain에서는 사용하지 않습니다. -->
        <add name="AiInferenceDatabase"
             connectionString=""
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="PcaExadataQuery"
             value="SELECT J.ENGR_RSLT_VAL AS LABEL_Y, M.* FROM TASADM.PCCB_INFER_RSLT_INF M LEFT JOIN TASDEV.PCCB_JUDGE_RSLT_INF J ON M.DRAFT_NO = J.DRAFT_NO AND M.PARAM_TYP = J.PARAM_TYP WHERE M.CHG_TM &gt; SYSDATE - 10 AND J.ENGR_RSLT_VAL IS NOT NULL" />
        <add key="PcaExadataJsonColumn" value="CONV_EXPER_CTN" />
        <add key="PcaExadataCommandTimeoutSeconds" value="120" />
        <add key="PcaActDataQuery" value="SELECT ACT_DATA FROM AI_INFERNECE" />
        <add key="PcaActDataCommandTimeoutSeconds" value="30" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1" />
    </startup>
</configuration>
