<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- 실제 서버/DB/인증 값은 배포 환경에서 설정합니다. 소스에 비밀번호를 저장하지 않습니다. -->
        <add name="AiInferenceDatabase"
             connectionString=""
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="PcaActDataQuery" value="SELECT ACT_DATA FROM AI_INFERNECE" />
        <add key="PcaActDataCommandTimeoutSeconds" value="30" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1" />
    </startup>
</configuration>
