# 이 파일을 python_tsne/.env로 복사한 뒤 실제 접속정보를 입력합니다.
# DBeaver JDBC URL 예: jdbc:oracle:thin:@db-server:1521/ORCL
# host=db-server, database=ORCL, port=1521, username/password=DBeaver 로그인 정보

TSNE_DB_HOST=127.0.0.1
TSNE_DB_DATABASE=ORCL
TSNE_DB_PORT=1521
TSNE_DB_USERNAME=test_user
TSNE_DB_PASSWORD=test_password

# 분석 조건: 차트 상단 Data Type의 초기 선택값
TSNE_DATA_TYPE=RESPONSE
# 기존 설정과의 호환을 위해 TSNE_PARAM_TYP도 지원합니다.
# TSNE_PARAM_TYP=RESPONSE
TSNE_TARGET_DRAFT_NO=

# 기본 SQL은 EXE에 포함되어 있습니다. SQL을 바꿀 때만 아래 설정을 사용합니다.
# TSNE_SQL_FILE=C:\\path\\custom_query.sql
# 또는 SQL 파일 대신 한 줄 SQL을 직접 지정할 수 있습니다.
# TSNE_SQL=SELECT DRAFT_NO, ENGR_RSLT_VAL, RSLT_CD, PARAM_TYP, CONV_EXPER_CTN FROM YOUR_SCHEMA.YOUR_TABLE WHERE ENGR_RSLT_VAL IS NOT NULL
