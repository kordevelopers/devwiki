# Copy this file to .env and fill in the values for real DB access.

# odbc or oracledb
TSNE_DB_MODE=oracledb

# Common Oracle listener values. For Exadata, SERVICE_NAME is normally required.
TSNE_ORACLE_HOST=10.0.0.10
TSNE_ORACLE_PORT=1521
TSNE_ORACLE_SERVICE_NAME=
TSNE_ORACLE_SID=

# ODBC mode. Oracle Instant Client ODBC driver must be registered on Windows first.
TSNE_ODBC_DSN=
TSNE_ODBC_DRIVER=Oracle in instantclient_23_8
TSNE_ODBC_USER=
TSNE_ODBC_PASSWORD=
# Optional full connection string. If set, it overrides DSN/user/password.
TSNE_ODBC_CONNECTION_STRING=

# python-oracledb thin mode. This does not require Oracle Client.
TSNE_ORACLE_USER=
TSNE_ORACLE_PASSWORD=
# Optional full DSN. If empty, HOST/PORT/SERVICE_NAME above are used.
TSNE_ORACLE_DSN=

# Query columns must include DRAFT_NO, PARAM_TYP, ENGR_RSLT_VAL or LABEL_Y,
# and CONV_EXPER_CTN. For multi-line SQL, use this file instead of TSNE_SQL.
TSNE_SQL_FILE=queries/exadata_tsne.sql
# Single-line fallback. Ignored when TSNE_SQL_FILE is set.
TSNE_SQL=SELECT DRAFT_NO, ENGR_RSLT_VAL, RSLT_CD, PARAM_TYP, CONV_EXPER_CTN FROM YOUR_SCHEMA.YOUR_TABLE WHERE ENGR_RSLT_VAL IS NOT NULL
TSNE_PARAM_TYP=RESPONSE
TSNE_TARGET_DRAFT_NO=

# If a TSNE_* connection value is absent, the runner also accepts the matching
# PCA_* value. PCA_DB_MODE=sample is not supported. When copying a PCA .env,
# set TSNE_DB_MODE and TSNE_SQL_FILE to the t-SNE values above.
