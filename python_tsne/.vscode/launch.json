{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run t-SNE from .env",
      "type": "debugpy",
      "request": "launch",
      "module": "tsne_runner",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "args": []
    },
    {
      "name": "Run t-SNE from PCCB CSV",
      "type": "debugpy",
      "request": "launch",
      "module": "tsne_runner",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "args": ["--source-csv", "C:\\temp\\pccb_export.csv"]
    }
  ]
}
