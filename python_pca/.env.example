# Copy this file to .env and fill in the values for real DB access.

# sample, odbc, or oracledb
PCA_DB_MODE=sample

# ODBC mode. The Oracle ODBC driver must be installed on Windows first.
PCA_ODBC_DSN=
PCA_ODBC_USER=
PCA_ODBC_PASSWORD=
# Optional full connection string. If set, it overrides DSN/user/password.
PCA_ODBC_CONNECTION_STRING=

# oracledb thin mode. This does not require Oracle Client.
PCA_ORACLE_USER=
PCA_ORACLE_PASSWORD=
PCA_ORACLE_DSN=host:1521/service_name

# Query columns must include DRAFT_NO, PARAM_TYP, LABEL_Y, CONV_EXPER_CTN.
PCA_SQL=SELECT M.DRAFT_NO, M.PARAM_TYP, J.ENGR_RSLT_VAL AS LABEL_Y, M.CONV_EXPER_CTN FROM TASADM.PCCB_INFER_RSLT_INF M JOIN TASADM.PCCB_JUDGE_RSLT_INF J ON M.DRAFT_NO = J.DRAFT_NO AND M.PARAM_TYP = J.PARAM_TYP WHERE M.CHG_TM > SYSDATE - 10 AND J.ENGR_RSLT_VAL IS NOT NULL
PCA_PARAM_TYP=RESPONSE
PCA_TARGET_DRAFT_NO=
