using System;
using System.IO;
using System.Runtime.InteropServices;
using System.Windows.Forms;
using Excel = Microsoft.Office.Interop.Excel;

namespace ExcelInteropTest
{
    public partial class Form1 : Form
    {
        private Button btnTest;
        private TextBox txtLog;

        public Form1()
        {
            InitializeComponent();
            CreateUi();
        }

        private void CreateUi()
        {
            Text = "Excel Interop RPC 테스트";
            Width = 700;
            Height = 450;
            StartPosition = FormStartPosition.CenterScreen;

            btnTest = new Button
            {
                Text = "Excel 테스트 실행",
                Width = 180,
                Height = 40,
                Left = 20,
                Top = 20
            };

            btnTest.Click += BtnTest_Click;

            txtLog = new TextBox
            {
                Multiline = true,
                ScrollBars = ScrollBars.Vertical,
                ReadOnly = true,
                Left = 20,
                Top = 80,
                Width = 640,
                Height = 300
            };

            Controls.Add(btnTest);
            Controls.Add(txtLog);
        }

        private void BtnTest_Click(object? sender, EventArgs e)
        {
            btnTest.Enabled = false;
            txtLog.Clear();

            try
            {
                Log("Excel Interop 테스트 시작");

                TestExcel();

                Log("테스트 성공");
            }
            catch (COMException ex)
            {
                Log("COM 오류 발생");
                Log($"HRESULT : 0x{ex.HResult:X8}");
                Log($"Message : {ex.Message}");
                Log(ex.ToString());

                MessageBox.Show(
                    $"COM 오류 발생\n\n" +
                    $"HRESULT : 0x{ex.HResult:X8}\n" +
                    $"Message : {ex.Message}",
                    "Excel Interop 오류",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                Log("일반 오류 발생");
                Log(ex.ToString());

                MessageBox.Show(
                    ex.ToString(),
                    "오류",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            finally
            {
                btnTest.Enabled = true;
            }
        }

        private void TestExcel()
        {
            Excel.Application? excel = null;
            Excel.Workbooks? workbooks = null;
            Excel.Workbook? workbook = null;
            Excel.Worksheet? worksheet = null;
            Excel.Range? cell = null;

            string folder = @"C:\Temp";
            string filePath = Path.Combine(folder, "ExcelInteropTest.xlsx");

            try
            {
                Directory.CreateDirectory(folder);

                if (File.Exists(filePath))
                {
                    File.Delete(filePath);
                }

                Log("1. Excel.Application 생성");

                excel = new Excel.Application
                {
                    Visible = false,
                    DisplayAlerts = false
                };

                Log($"Excel Version : {excel.Version}");

                Log("2. Workbooks 획득");

                workbooks = excel.Workbooks;

                Log("3. Workbook 생성");

                workbook = workbooks.Add();

                Log("4. Worksheet 획득");

                worksheet = (Excel.Worksheet)workbook.Worksheets[1];

                Log("5. A1 셀 획득");

                cell = (Excel.Range)worksheet.Cells[1, 1];

                Log("6. 셀 값 입력");

                cell.Value2 = "TEST";

                Log("7. Excel 파일 저장");

                workbook.SaveAs(filePath);

                Log($"저장 완료 : {filePath}");
            }
            finally
            {
                Log("8. Excel 종료 처리 시작");

                if (workbook != null)
                {
                    try
                    {
                        workbook.Close(false);
                        Log("Workbook.Close 성공");
                    }
                    catch (Exception ex)
                    {
                        Log($"Workbook.Close 실패 : {ex.Message}");
                    }
                }

                if (excel != null)
                {
                    try
                    {
                        excel.Quit();
                        Log("Excel.Quit 성공");
                    }
                    catch (Exception ex)
                    {
                        Log($"Excel.Quit 실패 : {ex.Message}");
                    }
                }

                ReleaseComObject(cell);
                ReleaseComObject(worksheet);
                ReleaseComObject(workbook);
                ReleaseComObject(workbooks);
                ReleaseComObject(excel);

                Log("9. COM 객체 해제 완료");
            }
        }

        private static void ReleaseComObject(object? obj)
        {
            if (obj == null)
                return;

            try
            {
                if (Marshal.IsComObject(obj))
                {
                    Marshal.FinalReleaseComObject(obj);
                }
            }
            catch
            {
                // 테스트 프로그램이므로 Release 오류는 무시
            }
        }

        private void Log(string message)
        {
            txtLog.AppendText(
                $"[{DateTime.Now:HH:mm:ss.fff}] {message}{Environment.NewLine}");
        }
    }
}