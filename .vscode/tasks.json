{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Python t-SNE (run once)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/python_tsne/scripts/setup_python.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/python_tsne"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Python t-SNE",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/python_tsne/scripts/run_tsne.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/python_tsne"
            },
            "problemMatcher": []
        }
    ]
}
