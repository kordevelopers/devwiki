# WinForms-only connection settings. Copy this file to oracle.env beside the EXE.
# Python .env and process environment variables are not used.
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=your_service
ORACLE_USERNAME=test_user
ORACLE_PASSWORD='test_password'

# Overall query/fetch deadline; expiry requests cancellation from Oracle.
QUERY_TIMEOUT_SECONDS=180
# Fetch buffer (bytes), LOB prefetch (characters for CLOB/NCLOB).
# Larger CLOB values are still read in full; these are not row/content limits.
FETCH_SIZE_BYTES=1048576
LOB_PREFETCH_CHARACTERS=32768

# Optional SQL file path, relative to this oracle.env. Takes priority over SQL.
SQL_FILE=
# If SQL is omitted, the built-in query selects labelled data from the last 10 days.
# SQL="SELECT ..."
